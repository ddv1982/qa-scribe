{
  "version": 1,
  "provider": "codex",
  "protocol": "app-server-jsonl",
  "cli_version": "synthetic",
  "scenario": "queued-allow-deny",
  "process": true,
  "constructor": {
    "prompt": "fixture prompt",
    "model": "chosen-model",
    "effort": "high",
    "cwd": "$CWD"
  },
  "initial": {
    "id": "qa-scribe-init",
    "method": "initialize",
    "params": {
      "clientInfo": {
        "name": "qa-scribe",
        "version": "$APP_VERSION"
      },
      "capabilities": {
        "experimentalApi": true
      }
    }
  },
  "steps": [
    {
      "op": "receive",
      "release": "initialized",
      "frame": {
        "id": "qa-scribe-init",
        "result": {}
      },
      "events": [
        {
          "send": {
            "method": "initialized"
          }
        },
        {
          "send": {
            "id": "qa-scribe-thread",
            "method": "thread/start",
            "params": {
              "ephemeral": true,
              "cwd": "$CWD",
              "model": "chosen-model"
            }
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "thread-announced",
      "frame": {
        "method": "thread/started",
        "params": {
          "thread": {
            "id": "thread-1"
          }
        }
      },
      "events": []
    },
    {
      "op": "receive",
      "release": "thread-response",
      "frame": {
        "id": "qa-scribe-thread",
        "result": {
          "thread": {
            "id": "thread-1"
          },
          "model": "reported-model"
        }
      },
      "events": [
        {
          "send": {
            "id": "qa-scribe-turn",
            "method": "turn/start",
            "params": {
              "threadId": "thread-1",
              "input": [
                {
                  "type": "text",
                  "text": "fixture prompt"
                }
              ],
              "model": "chosen-model",
              "effort": "high"
            }
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "turn-announced",
      "frame": {
        "method": "turn/started",
        "params": {
          "threadId": "thread-1",
          "turn": {
            "id": "turn-1",
            "status": "inProgress"
          }
        }
      },
      "events": []
    },
    {
      "op": "receive",
      "release": "text-before-turn-response",
      "frame": {
        "method": "item/agentMessage/delta",
        "params": {
          "threadId": "thread-1",
          "turnId": "turn-1",
          "delta": "Preamble"
        }
      },
      "events": [
        {
          "delta": "Preamble"
        }
      ]
    },
    {
      "op": "receive",
      "release": "turn-response",
      "frame": {
        "id": "qa-scribe-turn",
        "result": {
          "turn": {
            "id": "turn-1",
            "status": "inProgress"
          }
        }
      },
      "events": []
    },
    {
      "op": "receive",
      "release": "first-permission",
      "frame": {
        "id": "opaque:permission/481",
        "method": "mcpServer/elicitation/request",
        "params": {
          "threadId": "thread-1",
          "turnId": "turn-1",
          "serverName": "local",
          "request": {
            "mode": "form",
            "message": "Allow local.write?",
            "requestedSchema": {
              "type": "object",
              "properties": {}
            },
            "_meta": {
              "codex_approval_kind": "mcp_tool_call",
              "tool_params": {
                "path": "local-fixture-only",
                "nested": {
                  "raw": true
                }
              }
            }
          },
          "future_field": {
            "ignored": true
          }
        }
      },
      "events": [
        {
          "permission": {
            "can_approve": true,
            "title": "Allow local.write?",
            "tool_name": null,
            "server_name": "local",
            "input_json": "{\"nested\":{\"raw\":true},\"path\":\"local-fixture-only\"}"
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "queued-permission",
      "frame": {
        "id": 482,
        "method": "mcpServer/elicitation/request",
        "params": {
          "threadId": "thread-1",
          "turnId": "turn-1",
          "serverName": "local",
          "request": {
            "mode": "form",
            "message": "Allow local.write?",
            "requestedSchema": {
              "type": "object",
              "properties": {}
            },
            "_meta": {
              "codex_approval_kind": "mcp_tool_call",
              "tool_params": {
                "path": "local-fixture-only",
                "nested": {
                  "raw": true
                }
              }
            }
          },
          "future_field": {
            "ignored": true
          }
        }
      },
      "events": []
    },
    {
      "op": "decide",
      "release": "approve-head",
      "approved": true,
      "reply": {
        "id": "opaque:permission/481",
        "result": {
          "action": "accept",
          "content": {}
        }
      }
    },
    {
      "op": "next_permission",
      "release": "publish-next",
      "permission": {
        "can_approve": true,
        "title": "Allow local.write?",
        "tool_name": null,
        "server_name": "local",
        "input_json": "{\"nested\":{\"raw\":true},\"path\":\"local-fixture-only\"}"
      }
    },
    {
      "op": "decide",
      "release": "deny-next",
      "approved": false,
      "reply": {
        "id": 482,
        "result": {
          "action": "decline",
          "content": {}
        }
      }
    },
    {
      "op": "next_permission",
      "release": "queue-empty",
      "permission": null
    },
    {
      "op": "receive",
      "release": "final-snapshot",
      "frame": {
        "method": "item/completed",
        "params": {
          "threadId": "thread-1",
          "turnId": "turn-1",
          "item": {
            "type": "agentMessage",
            "text": "Connected."
          }
        }
      },
      "events": [
        {
          "snapshot": "Connected."
        }
      ]
    },
    {
      "op": "receive",
      "release": "terminal",
      "frame": {
        "method": "turn/completed",
        "params": {
          "threadId": "thread-1",
          "turn": {
            "id": "turn-1",
            "status": "completed"
          }
        }
      },
      "events": [
        {
          "snapshot": "Connected."
        },
        {
          "complete": true
        }
      ]
    }
  ],
  "finish": {
    "ok": "Connected."
  }
}
