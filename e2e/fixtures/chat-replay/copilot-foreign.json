{
  "version": 1,
  "provider": "copilot",
  "protocol": "acp-jsonl",
  "cli_version": "synthetic",
  "scenario": "foreign",
  "process": false,
  "constructor": {
    "prompt": "fixture prompt",
    "model": "chosen-model",
    "effort": "high",
    "cwd": "$CWD"
  },
  "initial": {
    "jsonrpc": "2.0",
    "id": "qa-scribe-init",
    "method": "initialize",
    "params": {
      "protocolVersion": 1,
      "clientCapabilities": {},
      "clientInfo": {
        "name": "qa-scribe",
        "version": "$APP_VERSION"
      }
    }
  },
  "steps": [
    {
      "op": "receive",
      "release": "initialized",
      "frame": {
        "jsonrpc": "2.0",
        "id": "qa-scribe-init",
        "result": {
          "protocolVersion": 1
        }
      },
      "events": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": "qa-scribe-session",
            "method": "session/new",
            "params": {
              "cwd": "$CWD",
              "mcpServers": []
            }
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "early-commands",
      "frame": {
        "method": "session/update",
        "params": {
          "sessionId": "session-1",
          "update": {
            "sessionUpdate": "available_commands_update",
            "availableCommands": []
          }
        }
      },
      "events": []
    },
    {
      "op": "receive",
      "release": "session-created",
      "frame": {
        "jsonrpc": "2.0",
        "id": "qa-scribe-session",
        "result": {
          "sessionId": "session-1"
        }
      },
      "events": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": "qa-scribe-prompt",
            "method": "session/prompt",
            "params": {
              "sessionId": "session-1",
              "prompt": [
                {
                  "type": "text",
                  "text": "fixture prompt"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "foreign",
      "frame": {
        "method": "session/update",
        "params": {
          "sessionId": "foreign-session",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Wrong"
            }
          }
        }
      },
      "error": "Protocol sessionId does not match active session/thread"
    },
    {
      "op": "receive",
      "release": "sticky-failure",
      "frame": {},
      "error": "Protocol sessionId does not match active session/thread"
    }
  ],
  "finish": {
    "error": "Protocol sessionId does not match active session/thread"
  }
}
