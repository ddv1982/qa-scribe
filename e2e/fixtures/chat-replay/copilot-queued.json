{
  "version": 1,
  "provider": "copilot",
  "protocol": "acp-jsonl",
  "cli_version": "synthetic",
  "scenario": "queued-allow-deny",
  "process": true,
  "constructor": {
    "prompt": "fixture prompt",
    "model": "chosen-model",
    "effort": "high",
    "cwd": "$CWD"
  },
  "initial": {
    "jsonrpc": "2.0",
    "id": "qa-scribe-init",
    "method": "initialize",
    "params": {
      "protocolVersion": 1,
      "clientCapabilities": {},
      "clientInfo": {
        "name": "qa-scribe",
        "version": "$APP_VERSION"
      }
    }
  },
  "steps": [
    {
      "op": "receive",
      "release": "initialized",
      "frame": {
        "jsonrpc": "2.0",
        "id": "qa-scribe-init",
        "result": {
          "protocolVersion": 1
        }
      },
      "events": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": "qa-scribe-session",
            "method": "session/new",
            "params": {
              "cwd": "$CWD",
              "mcpServers": []
            }
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "early-commands",
      "frame": {
        "method": "session/update",
        "params": {
          "sessionId": "session-1",
          "update": {
            "sessionUpdate": "available_commands_update",
            "availableCommands": []
          }
        }
      },
      "events": []
    },
    {
      "op": "receive",
      "release": "session-created",
      "frame": {
        "jsonrpc": "2.0",
        "id": "qa-scribe-session",
        "result": {
          "sessionId": "session-1"
        }
      },
      "events": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": "qa-scribe-prompt",
            "method": "session/prompt",
            "params": {
              "sessionId": "session-1",
              "prompt": [
                {
                  "type": "text",
                  "text": "fixture prompt"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "first-permission",
      "frame": {
        "jsonrpc": "2.0",
        "id": "opaque:permission/481",
        "method": "session/request_permission",
        "params": {
          "sessionId": "session-1",
          "toolCall": {
            "toolCallId": "opaque:permission/481",
            "title": "Write local fixture",
            "rawInput": {
              "path": "local-fixture-only",
              "nested": {
                "raw": true
              }
            }
          },
          "options": [
            {
              "optionId": "opaque-yes/opaque:permission/481",
              "kind": "allow_once",
              "name": "Once"
            },
            {
              "optionId": "opaque-no/opaque:permission/481",
              "kind": "reject_once",
              "name": "No"
            }
          ],
          "future_field": {
            "ignored": true
          }
        }
      },
      "events": [
        {
          "permission": {
            "can_approve": true,
            "title": "Write local fixture",
            "tool_name": null,
            "server_name": null,
            "input_json": "{\"nested\":{\"raw\":true},\"path\":\"local-fixture-only\"}"
          }
        }
      ]
    },
    {
      "op": "receive",
      "release": "queued-permission",
      "frame": {
        "jsonrpc": "2.0",
        "id": 482,
        "method": "session/request_permission",
        "params": {
          "sessionId": "session-1",
          "toolCall": {
            "toolCallId": "482",
            "title": "Write local fixture",
            "rawInput": {
              "path": "local-fixture-only",
              "nested": {
                "raw": true
              }
            }
          },
          "options": [
            {
              "optionId": "opaque-yes/482",
              "kind": "allow_once",
              "name": "Once"
            },
            {
              "optionId": "opaque-no/482",
              "kind": "reject_once",
              "name": "No"
            }
          ],
          "future_field": {
            "ignored": true
          }
        }
      },
      "events": []
    },
    {
      "op": "decide",
      "release": "approve-head",
      "approved": true,
      "reply": {
        "jsonrpc": "2.0",
        "id": "opaque:permission/481",
        "result": {
          "outcome": {
            "outcome": "selected",
            "optionId": "opaque-yes/opaque:permission/481"
          }
        }
      }
    },
    {
      "op": "next_permission",
      "release": "publish-next",
      "permission": {
        "can_approve": true,
        "title": "Write local fixture",
        "tool_name": null,
        "server_name": null,
        "input_json": "{\"nested\":{\"raw\":true},\"path\":\"local-fixture-only\"}"
      }
    },
    {
      "op": "decide",
      "release": "deny-next",
      "approved": false,
      "reply": {
        "jsonrpc": "2.0",
        "id": 482,
        "result": {
          "outcome": {
            "outcome": "selected",
            "optionId": "opaque-no/482"
          }
        }
      }
    },
    {
      "op": "next_permission",
      "release": "queue-empty",
      "permission": null
    },
    {
      "op": "receive",
      "release": "text",
      "frame": {
        "method": "session/update",
        "params": {
          "sessionId": "session-1",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Connected."
            }
          }
        }
      },
      "events": [
        {
          "delta": "Connected."
        }
      ]
    },
    {
      "op": "receive",
      "release": "terminal",
      "frame": {
        "jsonrpc": "2.0",
        "id": "qa-scribe-prompt",
        "result": {
          "stopReason": "end_turn"
        }
      },
      "events": [
        {
          "snapshot": "Connected."
        },
        {
          "complete": true
        }
      ]
    }
  ],
  "finish": {
    "ok": "Connected."
  }
}
