#!/usr/bin/env node
import { providerFixture } from '../chat-authorization-providers.mjs'
import { modelManagementEnabled, modelManagementFixture } from '../model-management-provider.mjs'
if (modelManagementEnabled) modelManagementFixture('copilot', process.argv.slice(2))
else providerFixture('copilot', process.argv.slice(2))
