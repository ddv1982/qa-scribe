#!/usr/bin/env node

import process from 'node:process'
import { existsSync, mkdirSync, readFileSync, watch, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { modelManagementEnabled, modelManagementFixture } from '../model-management-provider.mjs'
import { codexAppServer } from '../chat-authorization-codex.mjs'

const args = process.argv.slice(2)

function chatResponse(turn) {
  if (turn === 1) return 'Which build and environment did you test?'
  if (turn === 2) return 'What did you expect, and what happened instead?'
  return 'Your testing context is ready to submit as a Session Note.'
}

function parseChat(prompt) {
  const hasArgumentPair = (flag, value) => args.some((arg, index) => arg === flag && args[index + 1] === value)
  if (!args.includes('--ephemeral') || args.at(-1) !== '-'
    || args.includes('--sandbox') || hasArgumentPair('--config', 'features.shell_tool=false')) {
    throw new Error('Chat requires ephemeral stdin transport and inherited tool permissions')
  }
  const separator = '\nTRANSCRIPT_JSON\n'
  const dataStart = prompt.indexOf(separator)
  if (dataStart < 0) throw new Error('Chat prompt is missing TRANSCRIPT_JSON data')
  const transcript = JSON.parse(prompt.slice(dataStart + separator.length))
  const messages = transcript?.messages
  if (!Array.isArray(messages) || messages.length === 0 || messages.length % 2 !== 1) {
    throw new Error('Chat transcript requires completed pairs followed by the latest user message')
  }
  for (const [index, message] of messages.entries()) {
    const role = index % 2 === 0 ? 'user' : 'assistant'
    if (message?.role !== role || typeof message.text !== 'string' || !message.text.trim()) {
      throw new Error(`Chat message ${index + 1} has invalid role order or text`)
    }
    if (role === 'assistant' && message.text !== chatResponse((index + 1) / 2)) {
      throw new Error(`Chat message ${index + 1} does not replay the deterministic assistant response`)
    }
  }
  return { messages, response: chatResponse((messages.length + 1) / 2), argv: args }
}

function reserveInvocation(controlDirectory) {
  for (let index = 1; index <= 100; index += 1) {
    try {
      mkdirSync(join(controlDirectory, `codex-exec-${index}.lock`))
      return index
    } catch (error) {
      if (error?.code !== 'EEXIST') throw error
    }
  }
  throw new Error('Codex fixture exceeded its coordinated invocation limit')
}

function waitForFile(path) {
  if (existsSync(path)) return Promise.resolve()
  return new Promise((resolve, reject) => {
    const watcher = watch(dirname(path), () => {
      if (existsSync(path)) {
        watcher.close()
        resolve()
      }
    })
    watcher.on('error', reject)
    if (existsSync(path)) {
      watcher.close()
      resolve()
    }
  })
}

if (process.env.QA_SCRIBE_E2E_SPEC === 'ask-ai-conversation-isolation.e2e.mjs' && args.includes('--version')) {
  process.stdout.write('codex-cli 0.163.0\n')
} else if (modelManagementEnabled) {
  modelManagementFixture('codex', args)
} else if (args[0] === 'app-server') {
  codexAppServer(args)
} else if (args[0] === 'exec') {
  let prompt = ''
  process.stdin.setEncoding('utf8')
  process.stdin.on('data', (chunk) => {
    prompt += chunk
  })
  process.stdin.on('end', async () => {
    try {
      const controlDirectory = process.env.QA_SCRIBE_E2E_FIXTURE_DIR
      if (!controlDirectory) throw new Error('QA_SCRIBE_E2E_FIXTURE_DIR is required by the deterministic Codex fixture')
      mkdirSync(controlDirectory, { recursive: true })
      const invocation = reserveInvocation(controlDirectory)
      const startedPath = join(controlDirectory, `codex-exec-${invocation}.started`)
      const releasePath = join(controlDirectory, `codex-exec-${invocation}.release`)

      const chat = /^QA_SCRIBE_CHAT_V[23]\n/.test(prompt) ? parseChat(prompt) : null
      const isTestware = !chat && /Create test scenarios with test cases from the selected note only/i.test(prompt)
      const isSummary = /Keep the output as a summarized QA note/i.test(prompt)
      const streamConfigPath = join(controlDirectory, 'testware-streamdown.json')
      const streamConfig = isTestware && existsSync(streamConfigPath)
        ? JSON.parse(readFileSync(streamConfigPath, 'utf8'))
        : null
      const escapeAttribute = (value) => String(value).replace(/[&<>"']/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[character])
      const html = streamConfig
        ? '<h2>E2E test cases</h2><h3>Scenario</h3>'
          + '<p><strong>Important</strong> <em>context</em> **literal** _name_ `code` [label](url) &amp; entities &lt;example&gt;</p>'
          + '<p>Deterministic generated case</p>'
          + '<ol start="7"><li>Seventh</li></ol><ul><li>Parent<ul><li>Nested</li></ul></li></ul>'
          + '<ul data-type="taskList"><li data-type="taskItem" data-checked="true"><label><input type="checkbox" checked="checked"><span></span></label><div><p>Verified</p></div></li>'
          + `<li data-type="taskItem" data-checked="false"><label><input type="checkbox"><span></span></label><div><p>Pending${escapeAttribute(streamConfig.wrappedTask || '')}</p></div></li></ul>`
          + (streamConfig.safeLink ? `<p><a href="${escapeAttribute(streamConfig.safeLink)}">${escapeAttribute(streamConfig.safeLink)}</a></p>` : '')
          + `<img src="qa-scribe-attachment://${escapeAttribute(streamConfig.attachmentId)}" alt="Managed evidence">`
          + `<img src="${escapeAttribute(streamConfig.remoteUrl)}" alt="Remote evidence" onclick="window.__streamdownHostile=true">`
          + '<script>window.__streamdownHostile=true</script>'
          + `<!--${' '.repeat(4096)}-->`
        : isTestware
        ? '<h2>E2E test cases</h2><ul><li>Deterministic generated case</li></ul>'
        : isSummary
          ? '<p>E2E generated summary.</p>'
          : '<h2>E2E finding</h2><p>Deterministic provider output.</p>'
      const marker = prompt.match(/<html_fragment_[a-f0-9]+>/i)?.[0]?.slice(1, -1)
      const response = chat ? chat.response : marker ? `<${marker}>${html}</${marker}>` : html
      const midpoint = Math.ceil(response.length / 2)

      if (chat) {
        writeFileSync(join(controlDirectory, `codex-exec-${invocation}.chat.json`), `${JSON.stringify(chat, null, 2)}\n`, { flag: 'wx' })
      }
      if (isTestware) {
        writeFileSync(join(controlDirectory, `codex-exec-${invocation}.prompt.txt`), prompt, { flag: 'wx' })
      }
      writeFileSync(startedPath, `${process.pid}\n`, { flag: 'wx' })
      process.stdout.write(`${JSON.stringify({ type: 'turn.started' })}\n`)
      if (streamConfig) {
        const finalDelta = marker ? `</${marker}>` : ''
        const firstDelta = marker ? `<${marker}>${html}` : html
        await new Promise((resolve, reject) => {
          process.stdout.write(`${JSON.stringify({ type: 'item/agentMessage/delta', delta: firstDelta })}\n`, (error) => {
            if (error) reject(error)
            else resolve()
          })
        })
        writeFileSync(join(controlDirectory, `codex-exec-${invocation}.partial`), `${process.pid}\n`, { flag: 'wx' })
        await waitForFile(releasePath)
        process.stdout.write(`${JSON.stringify({ type: 'item/agentMessage/delta', delta: finalDelta })}\n`)
        process.stdout.write(`${JSON.stringify({ type: 'item.completed', item: { type: 'agent_message', text: response } })}\n`)
        return
      }
      await waitForFile(releasePath)
      process.stdout.write(`${JSON.stringify({ type: 'item/agentMessage/delta', delta: response.slice(0, midpoint) })}\n`)
      setImmediate(() => {
        process.stdout.write(`${JSON.stringify({ type: 'item/agentMessage/delta', delta: response.slice(midpoint) })}\n`)
        process.stdout.write(`${JSON.stringify({ type: 'item.completed', item: { type: 'agent_message', text: response } })}\n`)
      })
    } catch (error) {
      console.error(error instanceof Error ? error.message : error)
      process.exitCode = 1
    }
  })
} else if (args[0] === 'debug' && args[1] === 'models') {
  process.stdout.write('{"models":[]}\n')
} else {
  process.stdout.write('qa-scribe deterministic codex fixture 1.0.0\n')
}
