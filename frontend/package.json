{
  "name": "qa-scribe-frontend",
  "private": true,
  "version": "0.8.27",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity error .",
    "lint:css": "node scripts/check-css-colors.mjs",
    "check": "bun run typecheck && bun run lint && bun run lint:css && bun run check:contrast",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "vitest run",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json && tsc-rs --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "typecheck:watch": "node ../scripts/run-frontend-dev.mjs watch",
    "dev:checked": "node ../scripts/run-frontend-dev.mjs checked",
    "preinstall": "node ../scripts/check-tauri-diagnostic-patch.mjs",
    "postinstall": "node ../scripts/prepare-rust-typescript-sdk.mjs",
    "sdk:prepare": "node ../scripts/prepare-rust-typescript-sdk.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/static-renderer": "^3.32.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "brace-expansion": "5.0.12",
    "jsdom": "^29.1.1",
    "tsc-rs": "0.7.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "yaml": "2.9.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "json5": "2.2.3",
    "semver": "6.3.1",
    "@babel/parser": "7.29.9"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.3",
    "@wdio/native-utils": "2.5.0",
    "deepmerge-ts": "8.0.0",
    "mocha": "11.7.5",
    "prosemirror-model": "1.25.12",
    "prosemirror-view": "1.42.6",
    "source-map-js": "1.2.2",
    "serialize-javascript": "7.0.7"
  },
  "patchedDependencies": {
    "@wdio/tauri-service@1.2.0": "patches/@wdio%2Ftauri-service@1.2.0.patch"
  }
}
